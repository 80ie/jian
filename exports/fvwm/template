SetEnv FVWM_PHOTON_FACE         "{face}"
SetEnv FVWM_PHOTON_FACE_HI      "{tone+2}"
SetEnv FVWM_PHOTON_HEADER       "{face}"
SetEnv FVWM_PHOTON_GUTTER       "{tone-1}"
SetEnv FVWM_PHOTON_FRAME_MID    "{tone-3}"
SetEnv FVWM_PHOTON_WELL         "{tone-1}"
SetEnv FVWM_PHOTON_FACE_ALT     "{face}"
SetEnv FVWM_PHOTON_BTN_HI       "{tone+3}"
SetEnv FVWM_PHOTON_BTN_LO       "{tone-3}"
SetEnv FVWM_PHOTON_WELL_SH      "{tone-2}"
SetEnv FVWM_PHOTON_WELL_LIP     "{tone+1}"
SetEnv FVWM_PHOTON_HI           "{tone+3}"
SetEnv FVWM_PHOTON_SH           "{tone-4}"
SetEnv FVWM_PHOTON_DARK         "{tone-6}"
SetEnv FVWM_PHOTON_HEADER_CELL  "{tone-1}"
SetEnv FVWM_PHOTON_HEADER_GLYPH "{tone-5}"
SetEnv FVWM_PHOTON_FIELD        "{tone+5}"
SetEnv FVWM_PHOTON_TROUGH       "{tone-2}"
SetEnv FVWM_PHOTON_TROUGH_SH    "{tone-4}"
SetEnv FVWM_PHOTON_GROOVE       "{tone-4}"
SetEnv FVWM_PHOTON_GROOVE_MID   "{tone-3}"
SetEnv FVWM_PHOTON_GROOVE_HI    "$[FVWM_PHOTON_GUTTER]"
SetEnv FVWM_PHOTON_GROOVE_LIP   "$[FVWM_PHOTON_BTN_HI]"
SetEnv FVWM_PHOTON_THUMB_HI     "{tone+4}"
SetEnv FVWM_PHOTON_THUMB_LO     "$[FVWM_PHOTON_HEADER_CELL]"
SetEnv FVWM_PHOTON_TICK_HI      "$[FVWM_PHOTON_BTN_LO]"
SetEnv FVWM_PHOTON_TICK_LO      "{tone-5}"
SetEnv FVWM_PHOTON_FILL_CPU     "{fill}"
SetEnv FVWM_PHOTON_FILL_MEM     "{fill}"
SetEnv FVWM_PHOTON_INK          "{ink}"
SetEnv FVWM_PHOTON_INK_OFF      "$[FVWM_PHOTON_GROOVE]"
SetEnv FVWM_PHOTON_PAGER_SECTION    "$[FVWM_PHOTON_WELL_SH]"
SetEnv FVWM_PHOTON_PAGER_DESK       "{pager_desk}"
SetEnv FVWM_PHOTON_PAGER_DESK_HI    "{tone+1}"
SetEnv FVWM_PHOTON_FILL_DISK        "$[FVWM_PHOTON_PAGER_DESK]"
SetEnv FVWM_PHOTON_PAGER_PAGE       "$[FVWM_PHOTON_TROUGH]"
SetEnv FVWM_PHOTON_PAGER_PAGE_HI    "$[FVWM_PHOTON_HEADER]"
SetEnv FVWM_PHOTON_PAGER_GRID       "$[FVWM_PHOTON_DARK]"
SetEnv FVWM_PHOTON_PAGER_WIN        "$[FVWM_PHOTON_WELL]"
SetEnv FVWM_PHOTON_PAGER_WIN_EDGE   "$[FVWM_PHOTON_DARK]"
SetEnv FVWM_PHOTON_PAGER_FOCUS      "$[FVWM_PHOTON_FACE_HI]"
SetEnv FVWM_PHOTON_PAGER_FOCUS_EDGE "$[FVWM_PHOTON_DARK]"

# Window decor: 40 inactive, 41 active, 15 close button.
Colorset 40 fg {face}, bg {tone-6}, hi, sh, Plain, NoShape
Colorset 41 fg {chrome+1}, bg {chrome-1}, hi, sh, Plain, NoShape
Colorset 15 fg {tone+5}, bg {chrome+1}, hi, sh, Plain, NoShape

#~~~~~~~ 5 - Menu - Inactive Item
